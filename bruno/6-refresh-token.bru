meta {
  name: 6 Refresh access token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/token/refresh/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-App-Platform: DeliveryApp
}

body:json {
  {
    "refresh": "{{refreshToken}}"
  }
}

script:post-response {
  // The app calls this automatically on any 401 (apiClient.ts).
  if (res.body && res.body.access) {
    bru.setEnvVar("accessToken", res.body.access);
  }
}
