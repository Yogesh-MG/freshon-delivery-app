meta {
  name: 1 Send OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/send-otp/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-App-Platform: DeliveryApp
}

body:json {
  {
    "phone": "{{phone}}"
  }
}

vars:pre-request {
  baseUrl: https://api.freshon.in
}
