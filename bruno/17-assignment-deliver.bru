meta {
  name: 17 Deliver stop (OTP or photo)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/delivery-partner/assignments/{{assignmentId}}/deliver/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-App-Platform: DeliveryApp
  Authorization: Bearer {{deviceKey}}
}

body:json {
  {
    "stop_id": "{{stopId}}",
    "type": "otp",
    "otp_code": "123456",
    "latitude": {{lat}},
    "longitude": {{lng}},
    "cod_collected": false
  }
}

docs {
  type is "otp" or "photo". For "photo", upload via request 21 first and omit otp_code.
  cod_collected is sent by the app but the backend does not persist it yet
  (see deliveryAssignmentService.ts).
}
