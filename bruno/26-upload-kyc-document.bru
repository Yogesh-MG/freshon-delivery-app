meta {
  name: 26 Upload KYC document
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/delivery-partner/documents/
  body: multipartForm
  auth: none
}

headers {
  X-App-Platform: DeliveryApp
  Authorization: Bearer {{deviceKey}}
}

body:multipart-form {
  doc_type: aadhaar
  doc_number: 1234 5678 9012
  file: @file(./fixtures/aadhaar.jpg)
}

docs {
  doc_type: aadhaar | pan | driving_licence | vehicle_rc | insurance
  Returns the full documents list plus kyc_status (missing_documents, is_complete).
}
