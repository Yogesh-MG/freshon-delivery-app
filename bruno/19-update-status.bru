meta {
  name: 19 Go online / offline
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/delivery-partner/status/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-App-Platform: DeliveryApp
  Authorization: Bearer {{deviceKey}}
}

body:json {
  {
    "online": true,
    "latitude": {{lat}},
    "longitude": {{lng}}
  }
}

docs {
  Also called natively by the bg-location foreground service while a delivery
  is running, so the rider keeps reporting position with the app backgrounded.
}
