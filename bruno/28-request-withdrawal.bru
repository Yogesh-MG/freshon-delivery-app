meta {
  name: 28 Request withdrawal
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/delivery-partner/wallet/withdraw/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-App-Platform: DeliveryApp
  Authorization: Bearer {{deviceKey}}
}

body:json {
  {
    "amount": 500,
    "method": "UPI",
    "idempotency_key": "{{idempotencyKey}}"
  }
}

vars:pre-request {
  baseUrl: https://api.freshon.in
}

docs {
  method: UPI | BANK — must match the payout details saved on the profile (23).

  idempotency_key (round two, §8): a lost response must not turn one tap into two
  payouts. Send a fresh unique key per real request; re-sending the SAME key from the
  SAME rider returns the ORIGINAL withdrawal and does not debit again. See
  round2/withdraw-idempotent for the repeat-key assertion.
}
